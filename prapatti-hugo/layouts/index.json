{{- $items := slice -}}

{{- range site.Data.stotras_index -}}
  {{- $items = $items | append (dict "type" "stotra" "title" .name "subtitle" .author "tags" .tags "url" (printf "/stotras/?q=%s" (.name | urlize))) -}}
{{- end -}}

{{- range site.Data.categories_index -}}
  {{- $items = $items | append (dict "type" "category" "title" .title "subtitle" (printf "%d stotras" .count) "url" (printf "/categories/%s/" .slug)) -}}
{{- end -}}

{{- range site.Data.updates -}}
  {{- $items = $items | append (dict "type" "update" "title" .description "subtitle" .date "url" "/") -}}
{{- end -}}

{{- $items | jsonify -}}
